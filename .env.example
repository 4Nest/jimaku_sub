# Jimaku API Key (必需)
# 在 https://jimaku.cc/account 获取
JIMAKU_API_KEY=your_jimaku_api_key_here

# Telegram Bot Token (必需)
# 在 @BotFather 创建 Bot 获取
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (必需)
# 用户 ID 或群组 ID，可通过 @userinfobot 获取
TELEGRAM_CHAT_ID=your_chat_id_here

# 自动下载设置 (可选，默认 false)
DOWNLOAD_ENABLED=true
DOWNLOAD_PATH=/app/downloads

# 检查间隔 (可选，默认 300 秒)
SCHEDULER_INTERVAL_SECONDS=300

# 数据库路径 (可选，容器内默认 sqlite:///app/data/jimaku_subscriber.db)
#DATABASE_URL=sqlite:///app/data/jimaku_subscriber.db

# 日志保留天数 (可选，默认 30)
#LOG_RETENTION_DAYS=30

# 全量字幕频道推送 (可选，默认关闭)
# bot 需加为频道管理员；chat_id 为数字频道 id（-100 开头）
#CHANNEL_ENABLED=true
#CHANNEL_CHAT_ID=-100xxxxxxxxxx

# 订阅过滤 (可选)
# 只监控指定 AniList ID 的条目，逗号分隔
SUBSCRIPTION_ANILIST_IDS=

# 只监控名称包含关键词的条目，逗号分隔
SUBSCRIPTION_NAME_KEYWORDS=
